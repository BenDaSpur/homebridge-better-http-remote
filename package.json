{
  "name": "homebridge-esphome-buttons",
  "displayName": "ESPHome Buttons",
  "type": "module",
  "version": "1.0.10",
  "description": "Expose ESPHome device buttons as HomeKit switches (trigger via HTTP). Hold to repeat for brightness/fan.",
  "author": "Your Name",
  "license": "Apache-2.0",
  "homepage": "https://github.com/BenDaSpur/homebridge-esphome-buttons#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenDaSpur/homebridge-esphome-buttons.git"
  },
  "bugs": {
    "url": "https://github.com/BenDaSpur/homebridge-esphome-buttons/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "esphome",
    "http",
    "remote",
    "button"
  ],
  "files": [
    "dist",
    "config.schema.json"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "check": "npm run lint && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "homebridge-lib": "^7.1.12",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "homebridge": "^2.0.0-beta.55",
    "nodemon": "^3.1.11",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
